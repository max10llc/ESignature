<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#ffffff;margin:0;padding:0;border-collapse:collapse;">
  <tr>
    <td align="center" style="padding:24px 10px 24px 10px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;background-color:#ffffff;border:1px solid #e5e7eb;border-collapse:collapse;">
        <tr><td bgcolor="#0176d3" height="44" style="height:44px;background-color:#0176d3;font-size:0;line-height:44px;mso-line-height-rule:exactly;">&nbsp;</td></tr>
        <tr><td align="left" style="padding:18px 24px 14px 24px;border-bottom:1px solid #e5e7eb;">{{LogoHtml}}</td></tr>
        <tr><td style="padding:24px 24px 16px 24px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#374151;"><p style="Margin:0;">The signer opened the initial signature request email.</p></td></tr>
        <tr><td style="padding:0 24px 18px 24px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;background-color:#f7f8fa;border-left:4px solid #0176d3;"><tr><td style="padding:13px 16px;font-family:Arial,Helvetica,sans-serif;"><div style="font-size:12px;line-height:16px;color:#64748b;Margin:0 0 6px 0;">Document</div><div style="font-size:15px;line-height:20px;font-weight:bold;color:#111827;Margin:0;">{{DocumentTitle}}</div></td></tr></table></td></tr>
        <tr><td style="padding:0 24px 16px 24px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#374151;"><p style="Margin:0;"><strong>Signer:</strong> {{Signer}}</p></td></tr>
        <tr><td style="padding:0 24px 16px 24px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#374151;"><p style="Margin:0;"><strong>Time:</strong> {{EventTime}}</p></td></tr>
        <tr><td style="padding:0 24px 16px 24px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#374151;"><p style="Margin:0;"><a href="{{RecordUrl}}" style="color:#0176d3;text-decoration:underline;word-break:break-all;"><strong>Salesforce Record</strong></a></p></td></tr>
        <tr><td style="padding:0 24px 16px 24px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#64748b;"><p style="Margin:0;"><strong>IP Address:</strong> {{IPAddress}}</p></td></tr>
        <tr><td style="padding:0 24px 16px 24px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#64748b;"><p style="Margin:0;"><strong>User Agent:</strong> {{UserAgent}}</p></td></tr>
      </table>
    </td>
  </tr>
</table>

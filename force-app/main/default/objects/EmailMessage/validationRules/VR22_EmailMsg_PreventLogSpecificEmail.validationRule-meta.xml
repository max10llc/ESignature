<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR22_EmailMsg_PreventLogSpecificEmail</fullName>
    <active>true</active>
    <description>Prevents logging specific emails to a case.</description>
    <errorConditionFormula>AND(
    $Setup.Bypass_Validation_Rule__c.Email_Message__c = True ,
    CONTAINS( FromAddress , &apos;noreply@kaizonsolutions.com&apos; )
)</errorConditionFormula>
    <errorMessage>You cannot log this email. [VR22 Email Message]</errorMessage>
</ValidationRule>

<apex:page controller="ESignaturePageController" action="{!initializePage}" showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" applyHtmlTag="false" applyBodyTag="false">
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Electronic Signature</title>
    <script src="{!URLFOR($Resource.ESignature_PdfJs, 'pdf.min.js')}"></script>
    <style>
        html { height:100%; overflow:hidden; }
        body { height:100%; margin:0; overflow:hidden; font-family:Arial, sans-serif; background:#e8edf5; color:#111827; }
        form { height:100%; margin:0; overflow:hidden; }
        .wrap { width:100%; height:100vh; max-width:none; margin:0; padding:0; box-sizing:border-box; overflow:hidden; }
        .card { background:#fff; border-radius:0; box-shadow:none; padding:16px; margin-bottom:0; }
        h1 { margin:0 0 8px; font-size:28px; }
        h2 { margin:0 0 12px; font-size:21px; }
        label { display:block; font-weight:700; margin:14px 0 6px; }
        input[type=text], input[type=email], textarea { width:100%; box-sizing:border-box; border:1px solid #cbd5e1; border-radius:8px; padding:10px; font-size:15px; }
        .btn { background:#1e51a4; color:#fff; border:0; border-radius:8px; padding:11px 18px; font-weight:700; cursor:pointer; margin-top:14px; }
        .btn.secondary { background:#6b7280; }
        .btn.danger { background:#b91c1c; }
        .btn.linkbtn { display:inline-block; text-decoration:none; margin:0; }
        .fineprint { color:#4b5563; font-size:13px; line-height:1.45; }
        .msg { border-radius:8px; padding:12px 14px; margin:12px 0; background:#ecfdf5; color:#065f46; }
        .msg.err { background:#fef2f2; color:#991b1b; }
        .completion-overlay-backdrop { position:fixed; inset:0; z-index:1600; display:flex; align-items:center; justify-content:center; box-sizing:border-box; padding:22px; background:rgba(17,24,39,.46); }
        .completion-overlay { width:min(460px, 100%); box-sizing:border-box; background:#fff; border-radius:6px; box-shadow:0 24px 60px rgba(15,23,42,.28); padding:30px 34px; color:#111827; text-align:center; }
        .completion-overlay-title { margin:0 0 10px; color:#111827; font-size:22px; line-height:1.25; font-weight:700; }
        .completion-overlay-message { margin:0; color:#374151; font-size:15px; line-height:1.45; }
        .required-marker { color:#c23934; font-weight:bold; }
        .consent-pending .prepared-doc { filter:brightness(.62); }
        .consent-pending .field-layer { pointer-events:none; }
        .sender-consent-panel { display:none; width:274px; flex:0 0 274px; height:100vh; min-height:0; max-height:100vh; box-sizing:border-box; background:#fff; border-right:1px solid #e5e7eb; padding:clamp(12px, 2.6vh, 22px) 24px clamp(10px, 1.8vh, 12px); position:relative; z-index:40; flex-direction:column; overflow:hidden; gap:clamp(10px, 2vh, 16px); }
        .sender-panel-main { flex:1 1 auto; min-height:0; overflow:hidden; }
        .sender-panel-title { margin:0 0 clamp(5px, 1.3vh, 10px); color:#111827; font-size:clamp(18px, 2.7vh, 22px); line-height:1.18; font-weight:700; }
        .sender-panel-from { margin:0 0 clamp(8px, 2vh, 16px); color:#111827; font-size:13px; line-height:1.35; }
        .sender-panel-from strong { font-weight:700; }
        .sender-panel-divider { height:1px; background:#d1d5db; margin:0 0 clamp(8px, 1.8vh, 14px); }
        .sender-panel-message-title { margin:0 0 4px; color:#111827; font-size:clamp(14px, 2vh, 16px); line-height:1.2; font-weight:700; }
        .sender-panel-message { margin:0; color:#374151; font-size:14px; line-height:1.35; white-space:pre-line; max-height:8.1em; overflow:hidden; display:-webkit-box; -webkit-line-clamp:6; -webkit-box-orient:vertical; }
        .document-workspace { flex:1; min-width:0; height:100vh; min-height:0; overflow:hidden; display:flex; flex-direction:column; }
        .document-card { height:100vh; min-height:0; box-sizing:border-box; overflow:hidden; display:flex; flex-direction:column; padding:0; background:#f5f5f5; }
        .document-toolbar { flex:0 0 64px; height:64px; box-sizing:border-box; display:grid; grid-template-columns:minmax(180px, 1fr) minmax(180px, auto) minmax(260px, 1fr); align-items:center; gap:16px; padding:0 16px; background:#fff; border-bottom:1px solid #e5e7eb; color:#111827; }
        .document-toolbar-brand { display:flex; align-items:center; min-width:0; color:#111827; font-size:17px; line-height:1.2; font-weight:700; }
        .document-brand-text { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .document-toolbar-title { display:flex; align-items:center; justify-content:center; gap:8px; min-width:0; color:#111827; font-size:14px; font-weight:600; text-align:center; }
        .document-toolbar-title-text { display:block; max-width:36vw; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .document-toolbar-actions { display:flex; align-items:center; justify-content:flex-end; gap:10px; min-width:0; }
        .viewer-options { position:relative; }
        .viewer-options-button { min-height:34px; border:0; background:#fff; color:#111827; cursor:pointer; font-size:14px; padding:0 8px; display:flex; align-items:center; gap:6px; }
        .viewer-options-button-icon { display:block; width:18px; height:18px; object-fit:contain; }
        .viewer-options-menu { display:none; position:absolute; right:0; top:42px; width:242px; box-sizing:border-box; background:#fff; border:1px solid #b8b8b8; border-radius:2px; box-shadow:0 8px 18px rgba(15,23,42,.22); padding:11px 12px 10px; z-index:45; color:#242424; }
        .viewer-options-menu.open { display:block; }
        .viewer-menu-header { margin-bottom:8px; }
        .viewer-menu-from { font-size:11px; line-height:1.2; color:#2b2b2b; text-transform:uppercase; }
        .viewer-menu-message { margin:11px 0 10px; color:#2b2b2b; font-size:14px; line-height:1.35; }
        .viewer-menu-message strong { display:block; font-weight:400; }
        .viewer-menu-message span { display:block; color:#3f3f3f; white-space:pre-line; }
        .viewer-menu-divider { height:1px; background:#cfcfcf; margin:8px 0; }
        .viewer-menu-item { width:100%; min-height:32px; box-sizing:border-box; display:flex; align-items:center; gap:10px; border:0; background:#fff; color:#2b2b2b; font-size:14px; line-height:1.2; text-align:left; text-decoration:none; cursor:pointer; padding:6px 0; }
        .viewer-menu-item:hover { background:#f5f5f5; }
        .viewer-menu-icon { flex:0 0 18px; width:18px; height:18px; position:relative; color:#505050; display:inline-flex; align-items:center; justify-content:center; font-size:15px; line-height:1; }
        .viewer-menu-icon-image { display:block; width:18px; height:18px; object-fit:contain; }
        .viewer-icon-image { display:block; width:18px; height:18px; object-fit:contain; }
        .viewer-toolbar-divider { width:1px; height:28px; background:#d1d5db; }
        .viewer-icon-button { width:34px; height:34px; border:0; border-radius:4px; background:#fff; color:#111827; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:20px; line-height:1; text-decoration:none; }
        .viewer-icon-button:hover,
        .viewer-options-button:hover { background:#f3f4f6; }
        .right-rail-arrow-button { font-size:0; }
        .right-rail-arrow-button:before { content:""; width:10px; height:10px; border-top:2px solid #374151; border-right:2px solid #374151; display:block; }
        .right-rail-arrow-button.prev:before { transform:rotate(-45deg); }
        .right-rail-arrow-button.next:before { transform:rotate(135deg); }
        .viewer-zoom-label { min-width:42px; color:#374151; font-size:13px; text-align:center; }
        .document-body { flex:1 1 auto; min-height:0; display:flex; background:#f3f4f6; }
        .document-viewer { flex:1 1 auto; min-width:0; min-height:0; display:flex; }
        .document-right-rail { flex:0 0 56px; width:56px; box-sizing:border-box; background:#f7f7f7; border-left:1px solid #e5e7eb; display:flex; flex-direction:column; align-items:center; padding:14px 8px; gap:10px; color:#374151; }
        .document-right-rail .viewer-toolbar-divider { width:28px; height:1px; }
        .right-rail-spacer { flex:1 1 auto; }
        .right-rail-page { display:flex; flex-direction:column; align-items:center; gap:8px; color:#374151; font-size:13px; }
        .right-rail-page-current { min-width:30px; height:30px; border:1px solid #d1d5db; border-radius:2px; background:#fff; display:flex; align-items:center; justify-content:center; color:#111827; }
        .right-rail-page-total { min-width:30px; text-align:center; }
        .consent-overlay { flex:0 0 auto; width:100%; box-sizing:border-box; background:#fff; border-radius:8px; box-shadow:0 10px 28px rgba(15,23,42,.16); padding:clamp(10px, 2vh, 16px); }
        .consent-overlay-text { color:#111827; font-size:13px; line-height:1.35; margin:0 0 clamp(8px, 1.8vh, 14px); }
        .consent-overlay-text a { color:#0b66da; font-weight:700; text-decoration:none; }
        .consent-overlay-actions { position:relative; display:flex; align-items:center; gap:10px; }
        .consent-options-button { flex:1; min-height:36px; border:1px solid #a3a3a3; border-radius:999px; background:#e5e5e5; color:#111827; cursor:pointer; font-size:13px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:6px; }
        .consent-continue-button { flex:1; min-height:36px; border:0; border-radius:999px; background:#0b66da; color:#fff; cursor:pointer; font-size:13px; font-weight:700; }
        .consent-options-menu { display:none; position:absolute; left:0; bottom:46px; width:255px; background:#fff; border:1px solid #d1d5db; border-radius:4px; box-shadow:0 12px 30px rgba(15,23,42,.22); padding:7px 0; z-index:35; }
        .consent-options-menu.open { display:block; }
        .consent-menu-item { width:100%; box-sizing:border-box; display:flex; align-items:center; gap:10px; min-height:34px; padding:7px 13px; border:0; background:#fff; color:#111827; font-size:13px; line-height:1.2; text-align:left; text-decoration:none; cursor:pointer; }
        .consent-menu-item:hover { background:#f3f4f6; }
        .consent-menu-item.disabled { color:#6b7280; cursor:default; }
        .consent-menu-icon { width:15px; color:#4b5563; text-align:center; font-weight:700; }
        .consent-menu-icon-image { display:block; width:15px; height:15px; object-fit:contain; }
        .consent-menu-divider { height:1px; background:#e5e7eb; margin:6px 12px; }
        .signing-workspace { display:none; height:100vh; min-height:0; width:100%; overflow:hidden; }
        .signing-workspace.consent-required .sender-consent-panel { display:flex; }
        .hidden-consent { display:none; }
        .pdf-tools { display:none; }
        .prepared-doc-shell { position:relative; flex:1 1 auto; min-height:0; display:flex; flex-direction:column; }
        .prepared-doc { flex:1 1 auto; min-height:0; border:0; border-radius:0; background:#f3f4f6; padding:0 16px 86px; overflow:auto; }
        .pdf-page { position:relative; margin:0 auto 18px auto; background:#fff; box-shadow:0 3px 14px rgba(15,23,42,.18); width:fit-content; }
        .pdf-page canvas { display:block; }
        .page-label { display:none; }
        .field-layer { position:absolute; inset:0; z-index:5; }
        .prepared-field { position:absolute; box-sizing:border-box; border:2px solid #1e51a4; background:#e0f2ff; color:#0f172a; border-radius:4px; padding:3px 6px; font-size:12px; font-weight:700; cursor:pointer; overflow:hidden; text-align:left; }
        .prepared-field.required { border-color:#c23934; }
        .prepared-field.completed { border-color:transparent; background:transparent; box-shadow:none; }
        .prepared-field.completed .field-label { display:none; }
        .prepared-field.completed .field-value { width:100%; height:100%; display:flex; align-items:center; justify-content:center; line-height:1.2; text-align:center; }
        .prepared-field .field-label { opacity:.78; display:block; font-size:10px; line-height:11px; }
        .prepared-field .field-value { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .prepared-field.direct-input { cursor:text; padding:2px 5px; }
        .prepared-field-input[type=text] { width:100%; box-sizing:border-box; border:0; border-radius:0; padding:0; background:transparent; color:#0f172a; font-size:12px; font-weight:700; outline:none; }
        .prepared-field.type-checkbox { display:flex; align-items:center; justify-content:center; padding:0; text-align:center; font-size:18px; line-height:1; }
        .prepared-field.type-checkbox .field-label { display:none; }
        .prepared-field.type-name,
        .prepared-field.type-date { cursor:default; }
        .prepared-field.type-signature,
        .prepared-field.type-name,
        .prepared-field.type-title,
        .prepared-field.type-date { display:flex; align-items:center; justify-content:center; text-align:center; padding:0 6px; }
        .prepared-field.type-name .field-label,
        .prepared-field.type-title .field-label,
        .prepared-field.type-date .field-label { display:none; }
        .prepared-field.type-signature .field-value,
        .prepared-field.type-name .field-value,
        .prepared-field.type-title .field-value,
        .prepared-field.type-date .field-value { width:100%; display:flex; align-items:center; justify-content:center; line-height:1.2; text-align:center; }
        .prepared-field.type-title .field-value { height:100%; }
        .prepared-field.type-title .prepared-field-input[type=text] { height:100%; text-align:center; }
        .prepared-field.type-signature .field-value { height:100%; }
        .prepared-field.type-signature .signature-preview-image { display:block; max-width:100%; max-height:100%; object-fit:contain; }
        .prepared-field.type-signature .field-label { position:absolute; top:2px; left:5px; color:#c23934; opacity:1; font-size:13px; line-height:12px; }
        .prepared-field.type-signature.completed .field-value { font-family:"Brush Script MT","Segoe Script",cursive; font-size:18px; font-weight:500; }
        .prepared-field.required.required-nav-highlight { border-color:#0b66da; background:#e0f2ff; box-shadow:0 0 0 4px rgba(11,102,218,.24); }
        .required-field-nav { position:absolute; left:50%; bottom:16px; transform:translateX(-50%); z-index:20; width:min(452px, calc(100% - 24px)); min-height:54px; border-radius:999px; background:#0b66da; color:#fff; display:flex; align-items:center; justify-content:space-between; gap:14px; padding:0 6px; box-shadow:0 8px 22px rgba(15,23,42,.22); }
        .required-field-nav[hidden] { display:none; }
        .required-field-nav-text { flex:1; text-align:center; font-size:14px; font-weight:700; line-height:1.2; }
        .required-field-nav-button { width:46px; height:46px; border:0; border-radius:50%; background:#f8fafc; cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
        .required-field-nav-button:disabled { opacity:.55; cursor:default; }
        .required-field-nav-button:before { content:""; width:11px; height:11px; border-top:3px solid #0b66da; border-right:3px solid #0b66da; display:block; }
        .required-field-nav-button.prev:before { transform:translateX(2px) rotate(-135deg); }
        .required-field-nav-button.next:before { transform:translateX(-2px) rotate(45deg); }
        .required-field-complete-text,
        .required-field-submit-button { display:none; }
        .required-field-nav.complete { left:0; right:0; bottom:0; transform:none; width:auto; min-height:56px; border-radius:0 0 8px 8px; justify-content:center; gap:24px; padding:0 18px; }
        .required-field-nav.complete .required-field-nav-button,
        .required-field-nav.complete .required-field-nav-text { display:none; }
        .required-field-nav.complete .required-field-complete-text { display:inline-block; font-size:13px; font-weight:700; line-height:1.2; }
        .required-field-nav.complete .required-field-submit-button { display:inline-block; border:0; border-radius:999px; background:#f8fafc; color:#0b66da; cursor:pointer; font-size:13px; font-weight:700; line-height:1; padding:12px 20px; animation:submitPulse 1.55s ease-in-out infinite; }
        @keyframes submitPulse {
            0% { box-shadow:0 0 0 0 rgba(248,250,252,.75), 0 0 0 7px rgba(248,250,252,.36); }
            70% { box-shadow:0 0 0 9px rgba(248,250,252,0), 0 0 0 14px rgba(248,250,252,0); }
            100% { box-shadow:0 0 0 0 rgba(248,250,252,0), 0 0 0 7px rgba(248,250,252,0); }
        }
        .signature-dialog-backdrop { display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:1000; align-items:center; justify-content:center; padding:18px; }
        .signature-dialog { width:min(640px, 100%); background:#fff; border-radius:8px; box-shadow:0 22px 60px rgba(0,0,0,.28); padding:20px; }
        .signature-dialog-actions, .signature-mode-actions { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:14px; }
        .signature-preview { min-height:54px; border:1px solid #cbd5e1; border-radius:8px; padding:10px 12px; font-family:"Brush Script MT","Segoe Script",cursive; font-size:32px; line-height:1.1; color:#111827; background:#fff; }
        .signature-pad-wrap { border:1px solid #cbd5e1; border-radius:8px; background:#fff; padding:10px; }
        #signatureDialogPad { width:100%; height:180px; border:1px dashed #94a3b8; border-radius:6px; background:#fff; touch-action:none; display:block; }
        .decline-dialog-backdrop { display:none; position:fixed; inset:0; background:rgba(17,24,39,.58); z-index:1200; align-items:center; justify-content:center; padding:18px; }
        .decline-dialog { width:min(640px, 100%); background:#fff; border-radius:4px; box-shadow:0 22px 60px rgba(0,0,0,.30); padding:40px; box-sizing:border-box; }
        .decline-dialog h2 { margin:0; font-size:18px; }
        .decline-dialog-rule { height:1px; background:#d1d5db; margin:14px 0 28px; }
        .decline-dialog-label { display:block; margin:0 0 10px; font-size:12px; font-weight:400; color:#374151; }
        .decline-modal-reason { width:100%; min-height:56px; box-sizing:border-box; border:1px solid #9ca3af; border-radius:0; padding:8px; font-size:14px; resize:vertical; }
        .decline-terms-row { display:flex; align-items:flex-start; gap:10px; margin-top:10px; font-size:14px; line-height:1.4; }
        .decline-terms-row input { margin-top:2px; }
        .decline-terms-row a { color:#0b66da; text-decoration:none; }
        .decline-dialog-actions { display:flex; justify-content:flex-end; align-items:center; gap:16px; margin-top:50px; }
        .decline-cancel-button { min-width:72px; min-height:34px; border:1px solid #d1d5db; border-radius:999px; background:#fff; color:#111827; cursor:pointer; font-size:13px; font-weight:700; }
        .decline-modal-submit { min-width:78px; min-height:34px; border:0; border-radius:999px; background:#0b66da; color:#fff; cursor:pointer; font-size:13px; font-weight:700; }
        .decline-modal-submit:disabled { background:#e5e7eb; color:#9ca3af; cursor:default; }
        .delegate-dialog-backdrop { display:none; position:fixed; inset:0; background:rgba(17,24,39,.58); z-index:1200; align-items:center; justify-content:center; padding:18px; }
        .delegate-dialog { width:min(640px, 100%); background:#fff; border-radius:4px; box-shadow:0 22px 60px rgba(0,0,0,.30); padding:40px; box-sizing:border-box; }
        .delegate-dialog h2 { margin:0; font-size:18px; }
        .delegate-dialog-rule { height:1px; background:#d1d5db; margin:14px 0 18px; }
        .delegate-dialog-copy { margin:0 0 16px; color:#111827; font-size:14px; line-height:1.55; }
        .delegate-dialog-label { display:block; margin:12px 0 8px; font-size:12px; font-weight:400; color:#374151; }
        .delegate-modal-input[type=text],
        .delegate-modal-message { width:100%; box-sizing:border-box; border:1px solid #9ca3af; border-radius:0; padding:8px; font-size:14px; }
        .delegate-modal-message { min-height:56px; resize:vertical; }
        .delegate-terms-row { display:flex; align-items:flex-start; gap:10px; margin-top:10px; font-size:14px; line-height:1.4; }
        .delegate-terms-row input { margin-top:2px; }
        .delegate-terms-row a { color:#0b66da; text-decoration:none; }
        .delegate-dialog-actions { display:flex; justify-content:flex-end; align-items:center; gap:16px; margin-top:50px; }
        .delegate-cancel-button { min-width:72px; min-height:34px; border:1px solid #d1d5db; border-radius:999px; background:#fff; color:#111827; cursor:pointer; font-size:13px; font-weight:700; }
        .delegate-modal-submit { min-width:86px; min-height:34px; border:0; border-radius:999px; background:#0b66da; color:#fff; cursor:pointer; font-size:13px; font-weight:700; }
        .delegate-modal-submit:disabled { background:#e5e7eb; color:#9ca3af; cursor:default; }
        .errors { color:#991b1b; background:#fef2f2; border-radius:8px; padding:8px 12px; margin: 12px 0; }
        @media (max-height: 700px) {
            .sender-consent-panel { padding-top:12px; padding-bottom:10px; gap:8px; }
            .sender-panel-title { font-size:19px; margin-bottom:5px; }
            .sender-panel-from { margin-bottom:8px; line-height:1.25; }
            .sender-panel-divider { margin-bottom:8px; }
            .sender-panel-message-title { font-size:14px; }
            .sender-panel-message { font-size:13px; line-height:1.3; max-height:5.2em; -webkit-line-clamp:4; }
            .consent-overlay { padding:10px; }

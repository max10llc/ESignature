            .signing-workspace { flex-direction:column; }
            .sender-consent-panel { width:100%; flex-basis:auto; height:auto; max-height:none; min-height:auto; border-right:0; border-bottom:1px solid #e5e7eb; padding:16px; overflow:visible; }
            .sender-panel-main { margin-bottom:18px; }
            .document-workspace { height:auto; flex:1 1 auto; min-height:0; }
            .document-card { height:100%; min-height:0; }
            .document-toolbar { flex-basis:auto; height:auto; min-height:64px; grid-template-columns:1fr; gap:8px; padding:10px 12px; }
            .document-toolbar-title { justify-content:flex-start; }
            .document-toolbar-title-text { max-width:100%; }
            .document-toolbar-actions { justify-content:flex-start; flex-wrap:wrap; }
            .document-right-rail { display:none; }
        }
    </style>
</head>
<body>
<apex:form id="form">
    <apex:inputHidden value="{!signatureImageDataUrl}" id="signatureImageDataUrl" />
    <apex:inputHidden value="{!signerFieldsJson}" id="signerFieldsJson" />
    <apex:inputHidden value="{!typedName}" id="typedName" />
    <apex:inputHidden value="{!signerTitle}" id="signerTitle" />
    <div class="wrap">
        <div id="terminalMessageHost">
            <apex:outputPanel rendered="{!hasError}">
                <div class="card"><div class="msg err">{!pageMessage}</div></div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!submitted}" layout="none">
                <div class="completion-overlay-backdrop" role="dialog" aria-modal="true" aria-labelledby="completionOverlayTitle">
                    <div class="completion-overlay">
                        <h2 id="completionOverlayTitle" class="completion-overlay-title">{!terminalTitle}</h2>
                        <p class="completion-overlay-message">{!pageMessage}</p>
                    </div>
                </div>
            </apex:outputPanel>
        </div>

        <apex:pageMessages />

        <apex:outputPanel rendered="{!canSign}">
            <apex:inputCheckbox value="{!consent}" id="electronicConsent" styleClass="hidden-consent" />
            <apex:inputCheckbox value="{!disclosureAccepted}" id="electronicDisclosureAccepted" styleClass="hidden-consent" />

            <div id="signingWorkspace" class="signing-workspace">
                <aside class="sender-consent-panel" id="senderConsentPanel">
                    <div class="sender-panel-main">
                        <h1 class="sender-panel-title">Your turn to sign.</h1>
                        <p class="sender-panel-from">{!signerIntroText}</p>
                        <div class="sender-panel-divider"></div>
                        <h2 class="sender-panel-message-title">Message from {!senderDisplayName}:</h2>
                        <p class="sender-panel-message">{!envelopeMessage}</p>
                    </div>
                    <div class="consent-overlay" id="consentOverlay">
                        <p class="consent-overlay-text">
                            By selecting <strong>Continue</strong>, I agree to the
                            <a href="https://kaizonsolutions.com/wp-content/uploads/2026/05/Consumer-Disclosure.pdf" target="_blank">Consumer Disclosure</a>
                            and to use electronic signatures.
                        </p>
                        <div class="consent-overlay-actions">
                            <button type="button" class="consent-options-button" onclick="return toggleConsentOptions();">
                                <span>Options</span>
                            </button>
                            <button type="button" class="consent-continue-button" onclick="return acceptDisclosureOverlay();">Continue</button>
                            <div class="consent-options-menu" id="consentOptionsMenu">
                                <button type="button" class="consent-menu-item" onclick="return openDeclineDialog();">
                                    <span class="consent-menu-icon">
                                        <img class="consent-menu-icon-image" src="{!URLFOR($Resource.Decline_To_Sign_Button)}" alt="" />
                                    </span>
                                    <span>Decline to sign</span>
                                </button>
                                <button type="button" class="consent-menu-item" onclick="return openDelegateDialog();">
                                    <span class="consent-menu-icon">
                                        <img class="consent-menu-icon-image" src="{!URLFOR($Resource.Delegate_Signing_Button)}" alt="" />
                                    </span>
                                    <span>Delegate signing to another</span>
                                </button>
                                <div class="consent-menu-divider"></div>
                                <a id="consentDownloadPdfLink" class="consent-menu-item" href="#" target="_blank" download="download">
                                    <span class="consent-menu-icon">
                                        <img class="consent-menu-icon-image" src="{!URLFOR($Resource.Download_Document_Button)}" alt="" />
                                    </span>
                                    <span>Download PDF</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </aside>
                <div class="document-workspace">
                <div class="card document-card">
                    <div class="document-toolbar">
                        <div class="document-toolbar-brand">
                            <span class="document-brand-text">E-Signature</span>
                        </div>
                        <div class="document-toolbar-title">
                            <span class="document-toolbar-title-text">{!documentTitle}</span>
                        </div>
                        <div class="document-toolbar-actions">
                            <div class="viewer-options" id="viewerOptions">
                                <button type="button" class="viewer-options-button" onclick="return toggleViewerOptions();">
                                    <img class="viewer-options-button-icon" src="{!URLFOR($Resource.Options_Button)}" alt="" />
                                    <span>Options</span>
                                </button>
                                <div class="viewer-options-menu" id="viewerOptionsMenu">
                                    <div class="viewer-menu-header">
                                        <div class="viewer-menu-from">From {!senderDisplayName}</div>
                                    </div>
                                    <div class="viewer-menu-message">
                                        <strong>Message from {!senderDisplayName}:</strong>
                                        <span>{!envelopeMessage}</span>
                                    </div>
                                    <div class="viewer-menu-divider"></div>
                                    <button type="button" class="viewer-menu-item" onclick="return openDeclineDialog();">
                                        <span class="viewer-menu-icon">
                                            <img class="viewer-menu-icon-image" src="{!URLFOR($Resource.Decline_To_Sign_Button)}" alt="" />
                                        </span>
                                        <span>Decline to sign</span>
                                    </button>
                                    <button type="button" class="viewer-menu-item" onclick="return openDelegateDialog();">
                                        <span class="viewer-menu-icon">
                                            <img class="viewer-menu-icon-image" src="{!URLFOR($Resource.Delegate_Signing_Button)}" alt="" />
                                        </span>
                                        <span>Delegate signing to another</span>
                                    </button>
                                    <div class="viewer-menu-divider"></div>
                                    <button type="button" class="viewer-menu-item" onclick="return clearDocumentData();">
                                        <span class="viewer-menu-icon">
                                            <img class="viewer-menu-icon-image" src="{!URLFOR($Resource.Clear_Document_Buton)}" alt="" />
                                        </span>
                                        <span>Clear document data</span>
                                    </button>
                                    <div class="viewer-menu-divider"></div>
                                    <a id="viewerOptionsDownloadPdfLink" class="viewer-menu-item" href="#" target="_blank" download="download">
                                        <span class="viewer-menu-icon">
                                            <img class="viewer-menu-icon-image" src="{!URLFOR($Resource.Download_Document_Button)}" alt="" />
                                        </span>
                                        <span>Download PDF</span>
                                    </a>
                                </div>
                            </div>
                            <span class="viewer-toolbar-divider"></span>
                            <button type="button" class="viewer-icon-button" aria-label="Zoom out" onclick="zoomOut();">-</button>
                            <span class="viewer-zoom-label" id="zoomLabel">150%</span>
                            <button type="button" class="viewer-icon-button" aria-label="Zoom in" onclick="zoomIn();">+</button>
                            <a id="downloadPdfLink" class="viewer-icon-button" href="#" target="_blank" download="download" aria-label="Download PDF">
                                <img class="viewer-icon-image" src="{!URLFOR($Resource.Download_Document_Button)}" alt="" />
                            </a>
                        </div>
                    </div>
                    <div class="document-body">
                        <div class="document-viewer">
                            <div class="prepared-doc-shell consent-pending" id="preparedDocShell">
                                <div class="prepared-doc" id="pdfContainer">
                                    <div class="fineprint">Loading document...</div>
                                </div>
                                <div class="required-field-nav" id="requiredFieldNav" aria-live="polite" hidden="hidden">
                                    <button type="button" class="required-field-nav-button prev" aria-label="Previous required field" onclick="return navigateRequiredField(-1);"></button>
                                    <span class="required-field-nav-text" id="requiredFieldNavText">0 required fields remaining</span>
                                    <button type="button" class="required-field-nav-button next" aria-label="Next required field" onclick="return navigateRequiredField(1);"></button>
                                    <span class="required-field-complete-text">Click submit to sign.</span>
                                    <apex:commandButton value="Submit" action="{!sign}" onclick="return buildSignatureAndFields();" styleClass="required-field-submit-button" />
                                </div>
                            </div>
                        </div>
                        <div class="document-right-rail" aria-label="Document tools">
                            <div class="right-rail-spacer"></div>
                            <div class="right-rail-page">
                                <span class="right-rail-page-current" id="currentPageIndicator">1</span>
                                <span class="right-rail-page-total" id="pageCountIndicator">1</span>
                            </div>
                            <button type="button" class="viewer-icon-button right-rail-arrow-button prev" aria-label="Previous page" title="Previous page" onclick="return scrollDocumentPage(-1);"></button>
                            <button type="button" class="viewer-icon-button right-rail-arrow-button next" aria-label="Next page" title="Next page" onclick="return scrollDocumentPage(1);"></button>
                            <span class="viewer-toolbar-divider"></span>
                            <a id="rightRailDownloadPdfLink" class="viewer-icon-button" href="#" target="_blank" download="download" aria-label="Download PDF" title="Download PDF">
                                <img class="viewer-icon-image" src="{!URLFOR($Resource.Download_Document_Button)}" alt="" />
                            </a>
                            <button type="button" class="viewer-icon-button" aria-label="Zoom in" title="Zoom in" onclick="zoomIn();">+</button>
                            <button type="button" class="viewer-icon-button" aria-label="Zoom out" title="Zoom out" onclick="zoomOut();">-</button>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </apex:outputPanel>
    </div>
    <apex:outputPanel rendered="{!canSign}" layout="none">
        <div id="declineDialogBackdrop" class="decline-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="declineDialogTitle">
            <div class="decline-dialog">
                <h2 id="declineDialogTitle">Decline agreement</h2>
                <div class="decline-dialog-rule"></div>
                <label class="decline-dialog-label" for="declineReasonInput">Please provide reason for declining this agreement <span class="required-marker">*</span></label>
                <apex:inputTextarea value="{!declineReason}" id="declineReasonInput" styleClass="decline-modal-reason" onkeyup="updateDeclineSubmitState();" onchange="updateDeclineSubmitState();" />
                <label class="decline-terms-row">
                    <apex:inputCheckbox value="{!declineTermsAccepted}" id="declineTermsAccepted" onclick="updateDeclineSubmitState();" />
                    <span>I have read and agree to the <a href="https://kaizonsolutions.com/wp-content/uploads/2026/05/Consumer-Disclosure.pdf" target="_blank">Consumer Disclosure</a>.</span>
                </label>
                <div class="decline-dialog-actions">
                    <button type="button" class="decline-cancel-button" onclick="return closeDeclineDialog();">Cancel</button>
                    <apex:commandButton value="Decline" action="{!decline}" onclick="return validateDeclineDialog();" styleClass="decline-modal-submit" />
                </div>
            </div>
        </div>
        <div id="delegateDialogBackdrop" class="delegate-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="delegateDialogTitle">
            <div class="delegate-dialog">
                <h2 id="delegateDialogTitle">Delegate agreement</h2>
                <div class="delegate-dialog-rule"></div>
                <p class="delegate-dialog-copy">To send this agreement to another individual for signature, enter their email address and a message below.</p>
                <label class="delegate-dialog-label" for="delegateEmailInput">Email <span class="required-marker">*</span></label>
                <apex:inputText value="{!delegateEmail}" id="delegateEmailInput" styleClass="delegate-modal-input" onkeyup="updateDelegateSubmitState();" onchange="updateDelegateSubmitState();" />
                <label class="delegate-dialog-label" for="delegateNameInput">Name <span class="required-marker">*</span></label>
                <apex:inputText value="{!delegateName}" id="delegateNameInput" styleClass="delegate-modal-input" onkeyup="updateDelegateSubmitState();" onchange="updateDelegateSubmitState();" />
                <label class="delegate-dialog-label" for="delegateMessageInput">Message <span class="required-marker">*</span></label>
                <apex:inputTextarea value="{!delegateMessage}" id="delegateMessageInput" styleClass="delegate-modal-message" onkeyup="updateDelegateSubmitState();" onchange="updateDelegateSubmitState();" />
                <label class="delegate-terms-row">
                    <apex:inputCheckbox value="{!delegateTermsAccepted}" id="delegateTermsAccepted" onclick="updateDelegateSubmitState();" />
                    <span>I have read and agree to the <a href="https://kaizonsolutions.com/wp-content/uploads/2026/05/Consumer-Disclosure.pdf" target="_blank">Consumer Disclosure</a>.</span>
                </label>
                <div class="delegate-dialog-actions">
                    <button type="button" class="delegate-cancel-button" onclick="return closeDelegateDialog();">Cancel</button>
                    <apex:commandButton value="Delegate" action="{!delegateAgreement}" onclick="return validateDelegateDialog();" styleClass="delegate-modal-submit" />
                </div>
            </div>
        </div>
    </apex:outputPanel>
</apex:form>
<div id="signatureDialogBackdrop" class="signature-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="signatureDialogTitle">
    <div class="signature-dialog">
        <h2 id="signatureDialogTitle">Add Signature</h2>
        <div class="signature-mode-actions">
            <button type="button" id="signatureModeTypedButton" class="btn" onclick="setSignatureDialogMode('typed');">Type Name</button>
            <button type="button" id="signatureModeDrawButton" class="btn secondary" onclick="setSignatureDialogMode('draw');">Draw Signature</button>
        </div>
        <div id="signatureTypedPanel">
            <label>Typed Signature</label>
            <input type="text" id="signatureTypedName" autocomplete="name" oninput="updateSignaturePreview();" />
            <div id="signatureTypedPreview" class="signature-preview"></div>
        </div>
        <div id="signatureDrawPanel" style="display:none;">
            <label>Draw Signature</label>
            <div class="signature-pad-wrap"><canvas id="signatureDialogPad"></canvas></div>
            <button type="button" class="btn secondary" onclick="clearSignaturePad();">Clear Signature</button>
        </div>
        <div class="signature-dialog-actions">
            <button type="button" class="btn" onclick="applySignatureDialog();">Apply Signature</button>
            <button type="button" class="btn secondary" onclick="closeSignatureDialog();">Cancel</button>
        </div>
    </div>
</div>
<script>
var sitePrefix = '{!JSENCODE($Site.Prefix)}';
if (!sitePrefix || sitePrefix === '/') { sitePrefix = ''; }
var pdfToken = '{!JSENCODE(token)}';
var pdfUrl = sitePrefix + '/services/apexrest/ESignature/v1/pdf?t=' + encodeURIComponent(pdfToken);
var CHECKMARK_VALUE = '\u2713';
var downloadFileName = '{!JSENCODE(documentDownloadFileName)}';
if (!downloadFileName) { downloadFileName = 'document'; }
if (!/\.pdf$/i.test(downloadFileName)) { downloadFileName += '.pdf'; }
var preparedFields = JSON.parse('{!JSENCODE(fieldsJson)}');
var zoom = 1.5;
var pdfDocument = null;
var pdfPageCount = 0;
var signingExperienceStarted = false;
var signaturePadInitialized = false;
var signaturePadIsDrawing = false;
var signaturePadHasInk = false;
var signaturePadCanvas;
var signaturePadCtx;
var activeSignatureFieldId = null;
var signatureDialogMode = 'typed';
var activeRequiredFieldId = null;

if (window.pdfjsLib) {
    pdfjsLib.GlobalWorkerOptions.workerSrc = '{!URLFOR($Resource.ESignature_PdfJs, 'pdf.worker.min.js')}';
}

function setDownloadLinks() {
    ['downloadPdfLink', 'consentDownloadPdfLink', 'viewerOptionsDownloadPdfLink', 'rightRailDownloadPdfLink'].forEach(function(id) {
        var link = document.getElementById(id);
        if (!link) { return; }
        link.href = pdfUrl;
        link.setAttribute('download', downloadFileName);
    });
}
function toggleConsentOptions() {
    var menu = document.getElementById('consentOptionsMenu');
    if (menu) { menu.classList.toggle('open'); }
    return false;
}
function closeConsentOptions() {
    var menu = document.getElementById('consentOptionsMenu');
    if (menu) { menu.classList.remove('open'); }
}
function toggleViewerOptions() {
    var menu = document.getElementById('viewerOptionsMenu');
    if (menu) { menu.classList.toggle('open'); }
    return false;
}
function closeViewerOptions() {
    var menu = document.getElementById('viewerOptionsMenu');
    if (menu) { menu.classList.remove('open'); }
}
function consentInput() {
    return document.querySelector('[id$="electronicConsent"]');
}
function disclosureAcceptedInput() {
    return document.querySelector('[id$="electronicDisclosureAccepted"]');
}
function setConsentAccepted(accepted) {
    var consent = consentInput();
    var disclosure = disclosureAcceptedInput();
    if (consent) { consent.checked = accepted === true; }
    if (disclosure) { disclosure.checked = accepted === true; }
}
function isConsentAccepted() {
    var consent = consentInput();
    var disclosure = disclosureAcceptedInput();
    return !!(consent && consent.checked && disclosure && disclosure.checked);
}
function isConsentOverlayActive() {
    var overlay = document.getElementById('consentOverlay');
    return !!(overlay && overlay.style.display !== 'none');
}
function requireDisclosureOverlay() {
    setConsentAccepted(false);
    var workspace = document.getElementById('signingWorkspace');
    if (workspace) { workspace.classList.add('consent-required'); }
    var shell = document.getElementById('preparedDocShell');
    if (shell) { shell.classList.add('consent-pending'); }
    var panel = document.getElementById('senderConsentPanel');
    if (panel) { panel.style.display = 'flex'; }
    var overlay = document.getElementById('consentOverlay');
    if (overlay) { overlay.style.display = 'block'; }
    closeConsentOptions();
    closeViewerOptions();
    updateRequiredFieldNav();
}
function acceptDisclosureOverlay() {
    setConsentAccepted(true);
    closeConsentOptions();
    closeViewerOptions();
    var workspace = document.getElementById('signingWorkspace');
    if (workspace) { workspace.classList.remove('consent-required'); }
    var shell = document.getElementById('preparedDocShell');
    if (shell) { shell.classList.remove('consent-pending'); }
    var panel = document.getElementById('senderConsentPanel');
    if (panel) { panel.style.display = 'none'; }
    var overlay = document.getElementById('consentOverlay');
    if (overlay) { overlay.style.display = 'none'; }
    updateRequiredFieldNav();
    return false;
}
function declineReasonInput() {
    return document.querySelector('[id$="declineReasonInput"]');
}
function declineTermsInput() {
    return document.querySelector('[id$="declineTermsAccepted"]');
}
function declineReasonValue() {
    var input = declineReasonInput();
    return input && input.value ? input.value.trim() : '';
}
function declineTermsChecked() {
    var input = declineTermsInput();
    return input ? input.checked === true : false;
}
function updateDeclineSubmitState() {
    var submitButton = document.querySelector('.decline-modal-submit');
    if (submitButton) {
        submitButton.disabled = !(declineReasonValue() && declineTermsChecked());
    }
}
function openDeclineDialog() {
    closeConsentOptions();
    closeViewerOptions();
    var backdrop = document.getElementById('declineDialogBackdrop');
    if (backdrop) {
        backdrop.style.display = 'flex';
        updateDeclineSubmitState();
        window.setTimeout(function() {
            var input = declineReasonInput();
            if (input) { input.focus(); }
        }, 0);
    }
    return false;
}
function closeDeclineDialog() {
    var backdrop = document.getElementById('declineDialogBackdrop');
    if (backdrop) { backdrop.style.display = 'none'; }
    return false;
}
function validateDeclineDialog() {
    if (!declineReasonValue()) {
        alert('Please provide a reason for declining this agreement.');
        var input = declineReasonInput();
        if (input) { input.focus(); }
        updateDeclineSubmitState();
        return false;
    }
    if (!declineTermsChecked()) {
        alert('Confirm the disclosure before declining.');
        updateDeclineSubmitState();
        return false;
    }
    return true;
}
function delegateEmailInput() {
    return document.querySelector('[id$="delegateEmailInput"]');
}
function delegateNameInput() {
    return document.querySelector('[id$="delegateNameInput"]');
}
function delegateMessageInput() {
    return document.querySelector('[id$="delegateMessageInput"]');
}
function delegateTermsInput() {
    return document.querySelector('[id$="delegateTermsAccepted"]');
}
function delegateEmailValue() {
    var input = delegateEmailInput();
    return input && input.value ? input.value.trim() : '';
}
function delegateNameValue() {
    var input = delegateNameInput();
    return input && input.value ? input.value.trim() : '';
}
function delegateMessageValue() {
    var input = delegateMessageInput();
    return input && input.value ? input.value.trim() : '';
}
function delegateTermsChecked() {
    var input = delegateTermsInput();
    return input ? input.checked === true : false;
}
function delegateEmailIsValid() {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(delegateEmailValue());
}
function updateDelegateSubmitState() {
    var submitButton = document.querySelector('.delegate-modal-submit');
    if (submitButton) {
        submitButton.disabled = !(delegateEmailIsValid() && delegateNameValue() && delegateMessageValue() && delegateTermsChecked());
    }
}
function openDelegateDialog() {
    closeConsentOptions();
    closeViewerOptions();
    var backdrop = document.getElementById('delegateDialogBackdrop');
    if (backdrop) {
        backdrop.style.display = 'flex';
        updateDelegateSubmitState();
        window.setTimeout(function() {
            var input = delegateEmailInput();
            if (input) { input.focus(); }
        }, 0);
    }
    return false;
}
function closeDelegateDialog() {
    var backdrop = document.getElementById('delegateDialogBackdrop');
    if (backdrop) { backdrop.style.display = 'none'; }
    return false;
}
function validateDelegateDialog() {
    if (!delegateEmailValue()) {
        alert('Enter the delegate email address.');
        var emailInput = delegateEmailInput();
        if (emailInput) { emailInput.focus(); }
        updateDelegateSubmitState();
        return false;
    }
    if (!delegateEmailIsValid()) {
        alert('Enter a valid delegate email address.');
        var invalidEmailInput = delegateEmailInput();
        if (invalidEmailInput) { invalidEmailInput.focus(); }
        updateDelegateSubmitState();
        return false;
    }
    if (!delegateNameValue()) {
        alert('Enter the delegate name.');
        var nameInput = delegateNameInput();
        if (nameInput) { nameInput.focus(); }
        updateDelegateSubmitState();
        return false;
    }
    if (!delegateMessageValue()) {
        alert('Enter a message for the delegate.');
        var messageInput = delegateMessageInput();
        if (messageInput) { messageInput.focus(); }
        updateDelegateSubmitState();
        return false;
    }
    if (!delegateTermsChecked()) {
        alert('Confirm the disclosure before delegating.');
        updateDelegateSubmitState();
        return false;
    }
    return true;
}
function showSigningWorkspace() {
    var signingWorkspace = document.getElementById('signingWorkspace');
    if (signingWorkspace) { signingWorkspace.style.display = 'flex'; }
}
function initializeSigningExperience() {
    if (signingExperienceStarted) { return; }
    signingExperienceStarted = true;
    setDownloadLinks();
    renderPdf().catch(function(e) {
        var container = document.getElementById('pdfContainer');
        if (container) {
            container.innerHTML = '<div class="msg err">Unable to load PDF: ' + e.message + '</div>';
        }
    });
}
function initializeConsentGate() {
    setDownloadLinks();
    if (document.getElementById('signingWorkspace')) {
        requireDisclosureOverlay();
        showSigningWorkspace();
        initializeSigningExperience();
    }
}
function showTerminalDocumentMessage(message) {
    var signingWorkspace = document.getElementById('signingWorkspace');
    if (signingWorkspace) { signingWorkspace.style.display = 'none'; }
    var host = document.getElementById('terminalMessageHost') || document.querySelector('.wrap');
    if (!host) { return; }
    var terminalMessage = document.getElementById('terminalDocumentMessage');
    if (!terminalMessage) {
        terminalMessage = document.createElement('div');
        terminalMessage.id = 'terminalDocumentMessage';
        terminalMessage.className = 'card';
        var messageBody = document.createElement('div');
        messageBody.className = 'msg';
        terminalMessage.appendChild(messageBody);
        host.appendChild(terminalMessage);
    }
    var messageTarget = terminalMessage.querySelector('.msg') || terminalMessage;
    messageTarget.textContent = message || 'This document is no longer available for signing.';
}

function getTypedName() {
    var input = document.querySelector('[id$="typedName"]');
    return input && input.value ? input.value.trim() : '';
}
function setTypedName(value) {
    var input = document.querySelector('[id$="typedName"]');
    if (input) { input.value = value || ''; }
}
function getSignerTitle() {
    var input = document.querySelector('[id$="signerTitle"]');
    return input && input.value ? input.value.trim() : '';
}
function setSignerTitle(value) {
    var input = document.querySelector('[id$="signerTitle"]');
    if (input) { input.value = value || ''; }
}
function todayText() {
    return new Date().toLocaleDateString('en-US');
}
function clearDocumentData() {
    closeViewerOptions();
    preparedFields.forEach(function(field) {
        field.value = '';
        field.completed = false;
        delete field.signatureImageDataUrl;
        delete field.signaturePreviewDataUrl;
    });
    setSignerTitle('');
    var signatureInput = document.querySelector('[id$="signatureImageDataUrl"]');
    if (signatureInput) { signatureInput.value = ''; }
    if (signaturePadInitialized && signaturePadCtx && signaturePadCanvas) {
        signaturePadCtx.clearRect(0, 0, signaturePadCanvas.width, signaturePadCanvas.height);
        signaturePadHasInk = false;
    }
    activeSignatureFieldId = null;
    activeRequiredFieldId = null;
    applyPreparedFieldDefaults();
    renderFieldLayer();
    updateRequiredFieldNav();
    return false;
}
function applyPreparedFieldDefaults() {
    var signerName = getTypedName();
    preparedFields.forEach(function(field) {
        var type = fieldTypeName(field);
        if (type === 'name') {
            field.value = signerName;
            field.completed = !!field.value;
